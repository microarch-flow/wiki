digraph knowledge {
  graph [rankdir=TB, bgcolor="#f5f6ef", pad="0.18", nodesep="0.24", ranksep="0.42", splines=polyline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", color="#82a18e", fillcolor="#e0ebe3", fontcolor="#173d35", penwidth=1.3, fontname="Noto Sans CJK SC", fontsize=15, margin="0.13,0.10"];
  edge [color="#396b55", penwidth=1.4, arrowsize=.65];
  A [label="A 共同基础\n4 篇"];
  B [label="B SRAM\n4 篇"];
  C [label="C 片上存储\n3 篇"];
  D [label="D Cache\n5 篇"];
  E [label="E 地址翻译\n5 篇"];
  F [label="F DRAM\n6 篇"];
  G [label="G 内存控制器\n5 篇"];
